# Use Node 20 Alpine
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install bash and other utils
RUN apk update && apk upgrade && apk add --no-cache bash

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy all source files
COPY . .

# Expose dev port
EXPOSE 3000

# Start Next.js in dev mode
CMD ["npx", "next", "dev", "-p", "3000"]